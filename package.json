{
  "name": "@dropb/ffprobe",
  "keywords": [
    "ffprobe",
    "media",
    "video",
    "audio",
    "stream"
  ],
  "version": "3.0.1",
  "description": "ffprobe wrapper",
  "files": [
    "lib"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    }
  },
  "engines": {
    "node": ">=14.17.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --out-dir lib",
    "build:watch": "npm run build -- --watch src",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "lint": "biome check --write src test examples",
    "postversion": "npm run build && git push --follow-tags"
  },
  "author": "kukhariev",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukhariev/ffprobe.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/chai": "5.2.3",
    "@types/ffprobe-static": "2.0.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.13",
    "chai": "6.2.2",
    "ffprobe-static": "3.1.0",
    "mocha": "11.7.5",
    "ts-node": "10.9.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  },
  "mocha": {
    "extension": [
      "ts"
    ],
    "spec": "test/**/*.spec.ts",
    "require": "ts-node/register"
  }
}
